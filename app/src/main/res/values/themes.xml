<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CompVisionApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>

        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <item name="colorSecondary">@color/accent_primary</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <item name="android:forceDarkAllowed">false</item>
    </style>

</resources>